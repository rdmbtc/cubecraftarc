# CubeCraft Tycoon - Arc Testnet Configuration

# Deployer private key (for Foundry deployment)
PRIVATE_KEY=0x_your_private_key_here

# Treasury address (receives rental fees and business fees)
TREASURY_ADDRESS=0x_your_treasury_address

# Admin address (game admin for minting land, etc.)
ADMIN_ADDRESS=0x_your_admin_address

# Land metadata base URI
LAND_BASE_URI=https://api.cubecraft.game/land/metadata/

# Frontend contract addresses (set after deployment)
VITE_LAND_NFT_ADDRESS=0x
VITE_LAND_RENTAL_ADDRESS=0x
VITE_GAME_ECONOMY_ADDRESS=0x
