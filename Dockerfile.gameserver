# CubeCraft Arc Tycoon - Game Server Dockerfile
FROM node:20-alpine AS build

RUN apk add git python3 make g++
RUN corepack enable

WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY renderer/package.json renderer/package.json
COPY renderer/viewer/sign-renderer/package.json renderer/viewer/sign-renderer/package.json

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source files
COPY tsconfig.json ./
COPY src/ src/
COPY scripts/ scripts/
COPY renderer/ renderer/

# ---- Run Stage ----
FROM node:20-alpine

RUN apk add git
RUN corepack enable

WORKDIR /app

# Copy dependencies and source from build stage
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./
COPY --from=build /app/tsconfig.json ./
COPY --from=build /app/src ./src
COPY --from=build /app/renderer ./renderer
COPY --from=build /app/scripts ./scripts

# Minecraft protocol port
EXPOSE 25565
# WebSocket API port
EXPOSE 25566
# HTTP REST API port
EXPOSE 25567

# Environment variables
ENV MC_PORT=25565
ENV WS_PORT=25566
ENV HTTP_PORT=25567
ENV NODE_ENV=production

ENTRYPOINT ["node", "--import", "tsx", "src/server/index.ts"]
